# region Interface Text
# =============================================================================
# Interface Text
# =============================================================================

[Language_zh]
# 用户交互（10条）
wait_user           = 等待用户操作
lock_success_title  = 钱币锁定成功
follow_steps        = 请按以下步骤操作
enter_shop          = 1. 进入游戏商店界面
select_item         = 2. 选中要锻造的遗物
press_enter         = 3. 按回车键开始自动锻造
press_esc           = 提示：按ESC可随时终止脚本
switch_window       = 请切换到游戏窗口
seconds_start       = 秒后开始
user_cancel         = 用户取消操作

# 运行状态（10条）
round_title         = 第
round_suffix        = 轮
item_index          = /10
recognize           = 识别
keep                = 保留
blacklist_deny      = 黑名单否决
total               = 累计
start_forge         = 开始自动锻造
esc_detected        = 检测到ESC键
user_stop           = 用户终止

# 统计报表（10条）
stats_title         = 运行统计
total_rounds        = 总轮数
total_scanned       = 扫描数
total_kept          = 保留数
keep_rate           = 保留率
kept_items          = 保留道具词条
blacklist_items     = 被黑名单否决
件                  = 件
log_saved           = 统计结果已保存至
program_done        = 程序执行完毕

[Language_en]
# User Interaction
wait_user           = Waiting for user input
lock_success_title  = Currency Lock Successful
follow_steps        = Please follow these steps
enter_shop          = 1. Enter the in-game shop
select_item         = 2. Select the relic to forge
press_enter         = 3. Press Enter to start auto-forging
press_esc           = Tip: Press ESC to stop at any time
switch_window       = Please switch to game window
seconds_start       = seconds until start
user_cancel         = User cancelled

# Running Status
round_title         = Round 
round_suffix        = Turn
item_index          = /10
recognize           = Recognized
keep                = Keep
blacklist_deny      = Blacklist Denied
total               = Total
start_forge         = Starting auto-forge
esc_detected        = ESC detected
user_stop           = User stopped

# Statistics Report
stats_title         = Statistics
total_rounds        = Total Rounds
total_scanned       = Scanned
total_kept          = Kept
keep_rate           = Keep Rate
kept_items          = Kept Items
blacklist_items     = Blacklist Denied
件                  = items
